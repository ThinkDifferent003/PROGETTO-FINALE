  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My little ember... if you ever find these words, please, do not hate me
    for leaving. I thought gold could buy us a life, but it only bought me a cage.
    I wanted to fill your stomach, but I only emptied my soul.\n\nThey are not the
    gods they claim to be. They have taken everything from me\u2014my dignity, my
    strength, and now, my breath. My body is a ruin they played with until it broke.\n\nDon't
    come looking for me. Stay in the shadows, stay small, stay alive. I am going
    where the fire doesn't burn. I love you. Forgive your big sister."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
